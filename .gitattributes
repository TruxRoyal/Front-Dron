# For text files: normalize to LF in repo, CRLF on Windows checkout if core.autocrlf=true
* text=auto

# Force LF for common source files
*.js     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf

# Prevent binary files from being modified
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.mp4    binary
*.exe    binary

# SonarQube files – prevent line ending conversion
.scannerwork/** -text
